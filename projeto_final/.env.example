# Modo padrao: local (Mac offline). Na EC2: PIPELINE_MODE=aws
PIPELINE_MODE=local

# Dataset ativo: oxford17 (dev) ou oxford102
DATASET=oxford17

# Postgres local (docker-compose.yml)
PGHOST=localhost
PGPORT=5433
PGDATABASE=iris_latente
PGUSER=admin
PGPASSWORD=adminpassword

# Apenas modo aws (imagens sempre em iris-cv-latente-data)
# Artefatos por dataset:
#   s3://iris-cv-latente-data/oxford-flower-17/...
#   s3://iris-cv-latente-data/oxford-flower-102/...
S3_BUCKET=iris-cv-latente-data
